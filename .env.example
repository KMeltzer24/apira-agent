# Copy to .env and adjust for your setup.

# Which tool packaging specialists use (one at a time):
#   mcp | python | skills_prompt | skills_shell
TOOL_MODE=mcp
# When TOOL_MODE is skills_prompt or skills_shell, set true so research skills
# call RAG MCP from *_MCP.md / *_shell_MCP.md (searchLocalFolder + searchVectorDB).
# Ignored for mcp and python modes.
SKILLS_MCP=false

# Apira MCP server endpoint (local Docker → host-published ports).
MCP_URL=http://host.docker.internal:8000/mcp

RAG_MCP_URL=http://host.docker.internal:8200/mcp

# Backend REST URLs used when TOOL_MODE is python or skills_shell (portfolio).
USER_SERVICE_URL=http://host.docker.internal:8001
PORTFOLIO_SERVICE_URL=http://host.docker.internal:8002

# Local stock-research corpus for python / skills_shell searchLocalFolder.
# In Docker this is mounted at /data/stock-research (see docker-compose.yml).
STOCK_RESEARCH_DIR=/data/stock-research
# Optional host path override for the compose volume (default: ../apira-rag/stock-research).
# STOCK_RESEARCH_HOST_PATH=../apira-rag/stock-research

# Gemini config. Get a key from https://aistudio.google.com/apikey
# After changing this, recreate containers (compose does not reload .env):
#   docker compose up -d --force-recreate supervisor portfolio research
LLM_MODEL=gemini-3.1-flash-lite
GOOGLE_API_KEY=your-gemini-api-key

# A2A registry (Nacos). Compose sets NACOS_SERVER_ADDR=nacos:8848.
# Local non-Docker discovery can use localhost:8848.
NACOS_SERVER_ADDR=nacos:8848

# Structured stdout logging.
LOG_LEVEL=INFO
LOG_FORMAT=json
ENVIRONMENT=development
SERVICE_NAME=apira-agent
