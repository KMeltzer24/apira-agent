# Copy to .env and adjust for your setup.

# Apira MCP server endpoint (the apira-mcp deployment on EC2).
MCP_URL=http://3.133.124.58:8000/mcp

# Local Ollama model used to drive the agent. Must support tool calling
# (e.g. llama3.1, qwen2.5, mistral-nemo).
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434
