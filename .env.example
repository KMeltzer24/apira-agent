# Copy to .env and adjust for your setup.

# Apira MCP server endpoint.
#   - Agent on EC2 (alongside apira-mcp): http://host.docker.internal:8000/mcp
#   - Agent on your Mac (MCP on EC2):      http://3.133.124.58:8000/mcp
MCP_URL=http://host.docker.internal:8000/mcp

# Gemini config. Get a key from https://aistudio.google.com/apikey
LLM_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=your-gemini-api-key
