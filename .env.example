# Copy to .env and adjust for your setup.

# Apira MCP server endpoint.
#   - Agent on your Mac (MCP also local):  http://host.docker.internal:8000/mcp
#   - Agent on EC2 (alongside apira-mcp): http://host.docker.internal:8000/mcp
#   - Agent on your Mac (MCP on EC2):      http://<EC2_PUBLIC_IP>:8000/mcp
MCP_URL=http://host.docker.internal:8000/mcp

# Apira RAG MCP server endpoint.
#   - Agent on your Mac (RAG also local):  http://host.docker.internal:8200/mcp
#   - Agent on EC2 (alongside apira-rag): http://host.docker.internal:8200/mcp
#   - Agent on your Mac (RAG on EC2):     http://<EC2_PUBLIC_IP>:8200/mcp
RAG_MCP_URL=http://host.docker.internal:8200/mcp

# Gemini config. Get a key from https://aistudio.google.com/apikey
LLM_MODEL=gemini-3.1-flash-lite
GOOGLE_API_KEY=your-gemini-api-key

# Structured stdout logging.
LOG_LEVEL=INFO
LOG_FORMAT=json
ENVIRONMENT=development
SERVICE_NAME=apira-agent
