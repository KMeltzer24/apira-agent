# Copy to .env and adjust for your setup.

# Apira MCP server endpoint.
#   - Agent on EC2 (alongside apira-mcp): http://host.docker.internal:8000/mcp
#   - Agent on your Mac (MCP on EC2):      http://3.133.124.58:8000/mcp
MCP_URL=http://host.docker.internal:8000/mcp

# Which LLM drives the agent: "google_genai" (Gemini API) or "ollama" (local).
LLM_PROVIDER=google_genai

# --- Gemini (LLM_PROVIDER=google_genai) ---
# Get a key from https://aistudio.google.com/apikey
LLM_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=your-gemini-api-key

# --- Local Ollama (LLM_PROVIDER=ollama) ---
# Needs Ollama running and a tool-capable model: ollama pull qwen2.5
OLLAMA_MODEL=qwen2.5
OLLAMA_BASE_URL=http://localhost:11434
